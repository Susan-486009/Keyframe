<!DOCTYPE html>
<html lang="en">
<head> 
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact & Support Shell — Keyframe</title>
  <link rel="stylesheet" href="css/brand.css">
  <link rel="stylesheet" href="css/contact.css">
</head>
<body>

  <!-- SITE SHELL: HEADER -->
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="index.html" class="logo"><img src="IMG-20260903-WA0152.jpg" alt="image of keyframe" width:700><span>.</span></a>
      <nav class="site-nav">
        <ul>
          <li><a href="index.html">Home</a></li>
          <li><a href="problem.html">Problem</a></li>
          <li><a href="directory.html">Milestones</a></li>
          <li><a href="guide.html">Guides & FAQ</a></li>
          <li><a href="contact.html" class="active">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="site-main wrap">
    
    <!-- PAGE PURPOSE BANNER -->
    <section class="task-banner card">
      <h1>Contact & Escalation Center</h1>
      <p>Need guidance on a missed immunisation milestone or technical support for your records? Use this page to route your query directly to our support team.</p>
    </section>

    <!-- CONTENT GRID -->
    <div class="content-grid">
      
      <!-- COLUMN 1: CONTACT FORM -->
      <section class="card form-section">
        <h2>Send an Inquiry</h2>
        <p><small>Fields marked with an asterisk are required for tracking.</small></p>
        
        <form class="contact-form">
          <div class="field">
            <label for="full-name">Full Name *</label>
            <input type="text" id="full-name" required placeholder="e.g. Jane Doe">
          </div>

          <div class="field">
            <label for="email">Email Address *</label>
            <input type="email" id="email" required placeholder="name@example.com">
          </div>

          <div class="field">
            <label for="inquiry-type">Topic *</label>
            <select id="inquiry-type" required>
              <option value="" disabled selected>Select a category</option>
              <option value="milestone">Milestone Schedule Inquiry</option>
              <option value="record">Record Update Request</option>
              <option value="technical">Website Technical Issue</option>
            </select>
          </div>

          <div class="field">
            <label for="message">Message *</label>
            <textarea id="message" rows="5" required placeholder="Describe your question or issue in detail..."></textarea>
          </div>

          <button type="submit" class="btn btn-primary">Submit Request</button>
        </form>
      </section>

      <!-- COLUMN 2: DIRECT SUPPORT MATRIX -->
      <aside class="support-sidebar">
        <div class="card direct-contacts">
          <h3>Direct Contacts</h3>
          <ul class="contact-list">
            <li>
              <strong>General Support:</strong>
              <p><small>support@keyframe-health.org</small></p>
            </li>
            <li>
              <strong>Record Assistance:</strong>
              <p><small>records@keyframe-health.org</small></p>
            </li>
            <li>
              <strong>Response Time:</strong>
              <p><small>Within 1-2 business days</small></p>
            </li>
          </ul>
        </div>

        <div class="card emergency-notice">
          <h3>Medical Emergency?</h3>
          <p>This contact hub is for administrative and milestone tracking queries only.</p>
          <p><strong>If a child is experiencing an urgent reaction, call emergency services immediately.</strong></p>
        </div>
      </aside>

    </div>
  </main>

  <!-- SITE SHELL: FOOTER -->
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="footer-col">
        <h4>Keyframe</h4>
        <p><small>Supporting immunisation tracking and milestone visibility.</small></p>
      </div>
      <div class="footer-col">
        <h4>Navigation</h4>
        <ul>
          <li><a href="index.html">Home</a></li>
          <li><a href="directory.html">Milestones</a></li>
          <li><a href="guide.html">Guides & FAQ</a></li>
          <li><a href="contact.html">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Legal</h4>
        <p><small>&copy; Keyframe Pod Project. All rights reserved.</small></p>
      </div>
    </div>
  </footer>

</body>
</html>
